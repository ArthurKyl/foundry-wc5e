    {
      "_id": "ySNULMvPgfKeXHfM",
      "name": "Spellcasting",
      "type": "feat",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": {
          "value": "<p>The dread lord is a 12th-level spellcaster. The dread lord's spellcasting ability is Charisma (spell save DC 19, +11 to hit with spell attacks). The dread lord has the following spells prepared: Cantrip (at will): <em>friends</em>, <em>prestidigitation</em>, <em>fire bolt</em>, <em>minor illusion</em> 1st level (4 slots): <em>sleep</em>, <em>false life</em>, <em>cause fear</em>, <em>charm person</em>, <em>hex</em> 2nd level (3 slots): <em>detect thoughts</em>, <em>invisibility</em>, <em>hold</em> <em>person</em>, <em>ray of enfeeblement</em> 3rd level (3 slots): <em>gaseous form</em>, <em>vampiric touch</em>, <em>bestow curse</em>, <em>hypnotic pattern</em> 4th level (3 slots): <em>blight</em>, <em>hallucinatory terrain</em> 5th level (2 slots): <em>hold monster</em>, <em>scrying</em> 6th level (1 slots): <em>mass suggestion</em></p>",
          "chat": ""
        },
