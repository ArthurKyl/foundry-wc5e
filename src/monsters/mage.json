    {
      "_id": "2U56qSIGG9nUX8ix",
      "name": "Spellcasting",
      "type": "feat",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": {
          "value": "<p>The mage is a 9th-level spellcaster. Its spellcasting ability is Intelligence (spell save DC 14, +6 to hit with spell attacks). The mage has following mage spells prepared: Cantrips (at will): <em>dancing lights</em>, <em>fire bolt</em>, <em>mage hand</em>, <em>prestidigitation</em> 1st level (4 slots): <em>detect magic</em>, ✦ <em>frostfire bolt</em>, <em>mage armor</em>, <em>magic missile</em> 2nd level (3 slots): <em>magic mouth</em>, <em>misty step</em>, <em>scorching ray</em> 3rd level (3 slots): ✦ <em>blizzard</em>, <em>counterspell</em>, <em>slow</em> 4th level (3 slots): ✦ <em>arcane barrage</em>, <em>dimension door</em>, <em>greater invisibility</em> 5th level (1 slot): <em>scrying</em> The mage cast <em>mage armor</em> on itself before combat.</p>",
          "chat": ""
        },
