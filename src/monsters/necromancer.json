    {
      "_id": "vOwbFPWiRZfDdQCV",
      "name": "Spellcasting",
      "type": "feat",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": {
          "value": "<p>The necromancer is a 7th-level spellcaster. Its spellcasting ability is Intelligence (spell save DC 15, +5 to hit with spell attacks). The necromancer has following warlock and priest spells prepared: Cantrips (at will): <em>blade ward</em>, <em>chill touch</em>, ✦ <em>shadow bolt</em> 1st level (4 slots): <em>cause fear</em> ^XGE^, ✦ <em>dark void</em>, <em>false life</em>, <em>ray of sickness</em> 2nd level (3 slots): <em>darkness</em>, <em>ray of enfeeblement</em>, <em>shatter</em> 3rd level (3 slots): <em>animate dead</em>, <em>bestow curse</em>, <em>vampiric touch</em> 4th level (1 slot): <em>sickening radiance</em> ^XGE^</p>",
          "chat": ""
        },
