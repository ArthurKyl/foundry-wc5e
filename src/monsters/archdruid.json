    {
      "_id": "ESuEpCH4Ne9H6v9d",
      "name": "Spellcasting (Spellcaster Form Only)",
      "type": "feat",
      "img": "icons/svg/item-bag.svg",
      "system": {
        "description": {
          "value": "<p>The archdruid is an 18th-level spellcaster. Its spellcasting ability is Wisdom (spell save DC 18, +10 to hit with spell attacks). The archdruid has the following druid spells prepared: Cantrips (at will): <em>druidcraft</em>, <em>shape water</em> ^XGE^, <em>shillelagh<strong>, ✦ </em>solar wrath<em> 1st level (4 slots): </em>cure wounds<em>, </em>entangle<em>, </em>speak with animals<em>, ✦ </em>starfire<em> 2nd level (3 slots): </em>animal messenger<em>, </em>barkskin</strong>, ✦ <em>cyclone</em> 3rd level (3 slots): <em>conjure animals</em>, <em>speak with plants</em>, ✦ <em>starsurge</em>, <em>water breathing</em> 4th level (3 slots): <em>dominate beast</em>, <em>grasping vine</em>, <em>guardian of nature</em> 5th level (3 slots): <em>commune with nature</em>, <em>mass cure wounds</em>, <em>wrath of nature</em> ^XGE^ 6th level (1 slot): <em>heal</em>, ✦ <em>starfall</em>, <em>sunbeam</em>, <em>wall of thorns</em> 7th level (1 slot): <em>whirlwind</em> ^XGE^ 8th level (1 slot): <em>control weather</em> 9th level (1 slot): <em>foresight</em> *The archdruid casts these spells on itself before combat.</p>",
          "chat": ""
        },
