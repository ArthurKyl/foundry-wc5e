    {
      "_id": "tyfTre66qR53R0YP",
      "name": "Curse of Doom",
      "type": "feat",
      "img": "icons/svg/sword.svg",
      "system": {
        "description": {
          "value": "<p>When the doomskull is reduced to 0 hit points from taking damage caused by another creature, it utters some incomprehensible words to curse the creature with doom. The creature has to make a DC 13 Wisdom saving throw or gain one level of exhaustion and become cursed. While cursed the creature cannot reduce its exhaustion level. Undead and constructs are immune to the curse.</p>",
          "chat": ""
        },
